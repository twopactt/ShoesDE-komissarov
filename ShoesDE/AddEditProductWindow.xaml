<Window x:Class="ShoesDE.AddEditProductWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ShoesDE"
        mc:Ignorable="d"
        Style="{StaticResource Windows}"
        Title="Редактирование продукта" Height="450" Width="800" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>

        <ScrollViewer>
            <StackPanel Margin="10">
                <TextBlock Text="Артикул" />
                <TextBox x:Name="ArticleTextBox"
                         MaxLength="10"/>
                
                <TextBlock Text="Наименование" />
                <TextBox x:Name="NameTextBox"
                         MaxLength="30"/>
                
                <TextBlock Text="Единица измерения" />
                <ComboBox x:Name="UnitComboBox" />
                
                <TextBlock Text="Цена" />
                <TextBox x:Name="PriceTextBox" />

                <TextBlock Text="Производитель" />
                <ComboBox x:Name="ProducerComboBox" />
                
                <TextBlock Text="Поставщик" />
                <ComboBox x:Name="ProviderComboBox" />
                
                <TextBlock Text="Категория" />
                <ComboBox x:Name="CategoryComboBox" />
                
                <TextBlock Text="Скидка" />
                <TextBox x:Name="DiscountTextBox" />
                
                <TextBlock Text="Количество на складе" />
                <TextBox x:Name="AmountInStockTextBox" />
                
                <TextBlock Text="Описание" />
                <TextBox x:Name="DescriptionTextBox"
                         Height="150"
                         TextWrapping="Wrap" />
                
                <TextBlock Text="Фото" />
                <TextBox x:Name="PhotoTextBox" />
            </StackPanel>
        </ScrollViewer>

        <Button x:Name="CancelButton"
                Content="Отменить"
                Grid.Row="1"
                Click="CancelButton_Click"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Margin="10 0" />

        <Button x:Name="SaveButton"
                Content="Сохранить"
                Grid.Row="1"
                Click="SaveButton_Click"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Margin="10 0" />
    </Grid>
</Window>
