<Window x:Class="ShoesDE.ProductWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ShoesDE"
        mc:Ignorable="d" Style="{StaticResource Windows}"
        Title="Продукты" Height="800" Width="1200" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>

        <Grid Name="AdminPanel" 
              HorizontalAlignment="Left">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="20 0">
                <TextBlock Text="Поиск" />
                <TextBox Name="SearchingTextBox"
                         Width="200"
                         TextChanged="SearchingTextBox_TextChanged"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="20 0">
                <TextBlock Text="Сортировка" />
                <ComboBox Name="SortingComboBox"
                          Width="200"
                          SelectionChanged="SortingComboBox_SelectionChanged"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Margin="20 0">
                <TextBlock Text="Фильтрация" />
                <ComboBox Name="FilteringComboBox"
                          Width="200"
                          SelectionChanged="FilteringComboBox_SelectionChanged"/>
            </StackPanel>
        </Grid>

        <TextBlock Name="FullUserName"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Top"
                   Margin="20 10"/>

        <ScrollViewer Grid.Row="1">
            <ItemsControl Name="ProductList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Tag="{Binding Id}"
                                Background="{Binding Background}"
                                MouseDown="Border_MouseDown"
                                Margin="10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0"
                                        Width="80"
                                        Height="80"
                                        Margin="15 0">
                                    <Image Source="{Binding Photo}"/>
                                </Border>
                                
                                <StackPanel Grid.Column="1">
                                    <TextBlock FontWeight="SemiBold">
                                        <Run Text="{Binding Category.Name}"/>
                                        <Run Text=" | "/>
                                        <Run Text="{Binding Name}"/>
                                    </TextBlock>
                                    
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Описание товара: "/>
                                        <TextBlock Text="{Binding Description}"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Производитель: "/>
                                        <TextBlock Text="{Binding Provider.Name}"/>
                                        
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Поставщик: "/>
                                        <TextBlock Text="{Binding Producer.Name}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Цена: "/>
                                        <TextBlock Text="{Binding Price, StringFormat=C2}"/>
                                        <TextBlock Text=" "/>
                                        <TextBlock Text="{Binding OldPrice, StringFormat=C2}"
                                                   Foreground="Red"
                                                   TextDecorations="Strikethrough"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Единица измерения: "/>
                                        <TextBlock Text="{Binding Unit.Name}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Количество на складе: "/>
                                        <TextBlock Text="{Binding AmountInStock}"/>
                                    </StackPanel>
                                </StackPanel>
                                <Border Grid.Column="2">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Discount}"/>
                                        <TextBlock Text="%"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Button Name="LogOutButton"
                Content="Выйти"
                Grid.Row="2"
                HorizontalAlignment="left"
                VerticalAlignment="Center"
                Margin="20 0"
                Click="LogOutButton_Click"/>

        <Button Name="CreateButton"
                Content="Создать"
                Grid.Row="2"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Margin="20 0"
                Visibility="Collapsed"
                Click="CreateButton_Click"/>
    </Grid>
</Window>